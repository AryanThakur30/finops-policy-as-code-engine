package infracost

import rego.v1

# Generated automatically by policy-generator.
# Do not edit this file manually.

{% for environment, values in budgets.items() %}
deny contains out if {
    input.environment == "{{ environment }}"
    actualCost := to_number(input.totalMonthlyCost)
    actualCost >= {{ "%.2f"|format(values.monthly_limit|float) }}

    out := {
        "policy": "monthly-budget-{{ environment }}",
        "msg": sprintf("Monthly infrastructure cost for {{ environment }} must be less than ${{ "%.2f"|format(values.monthly_limit|float) }} (actual cost is $%.2f)", [actualCost]),
        "failed": true,
    }
}

{% endfor %}
{% if cost_increase.enabled %}
deny contains out if {
    current := to_number(input.totalMonthlyCost)
    previous := to_number(input.pastTotalMonthlyCost)
    previous > 0
    increase := ((current - previous) / previous) * 100
    increase > {{ "%.2f"|format(cost_increase.max_percentage|float) }}

    out := {
        "policy": "cost-increase-guardrail",
        "msg": sprintf("Monthly infrastructure cost increased by %.2f%%, exceeding the allowed {{ "%.2f"|format(cost_increase.max_percentage|float) }}%%", [increase]),
        "failed": true,
    }
}

{% endif %}
{% for resource_type, values in resources.items() %}
{% if values.enabled %}
deny contains out if {
    resource := input.projects[_].breakdown.resources[_]
    contains(lower(resource.name), "{{ resource_type }}")
    cost := to_number(resource.monthlyCost)
    cost >= {{ "%.2f"|format(values.max_monthly_cost|float) }}

    out := {
        "policy": "resource-cost-{{ resource_type }}",
        "msg": sprintf("{{ resource_type }} resource cost must be less than ${{ "%.2f"|format(values.max_monthly_cost|float) }} (actual cost is $%.2f)", [cost]),
        "failed": true,
    }
}

{% endif %}
{% endfor %}
