package infracost

import rego.v1

# Generated automatically by policy-generator.
# Do not edit this file manually.

deny contains out if {
    input.environment == "development"
    actualCost := to_number(input.totalMonthlyCost)
    actualCost >= 100.00

    out := {
        "policy": "monthly-budget-development",
        "msg": sprintf("Monthly infrastructure cost for development must be less than $100.00 (actual cost is $%.2f)", [actualCost]),
        "failed": true,
    }
}

deny contains out if {
    input.environment == "staging"
    actualCost := to_number(input.totalMonthlyCost)
    actualCost >= 250.00

    out := {
        "policy": "monthly-budget-staging",
        "msg": sprintf("Monthly infrastructure cost for staging must be less than $250.00 (actual cost is $%.2f)", [actualCost]),
        "failed": true,
    }
}

deny contains out if {
    input.environment == "production"
    actualCost := to_number(input.totalMonthlyCost)
    actualCost >= 500.00

    out := {
        "policy": "monthly-budget-production",
        "msg": sprintf("Monthly infrastructure cost for production must be less than $500.00 (actual cost is $%.2f)", [actualCost]),
        "failed": true,
    }
}

deny contains out if {
    current := to_number(input.totalMonthlyCost)
    previous := to_number(input.pastTotalMonthlyCost)
    previous > 0
    increase := ((current - previous) / previous) * 100
    increase > 20.00

    out := {
        "policy": "cost-increase-guardrail",
        "msg": sprintf("Monthly infrastructure cost increased by %.2f%%, exceeding the allowed 20.00%%", [increase]),
        "failed": true,
    }
}

deny contains out if {
    resource := input.projects[_].breakdown.resources[_]
    contains(lower(resource.name), "ec2")
    cost := to_number(resource.monthlyCost)
    cost >= 200.00

    out := {
        "policy": "resource-cost-ec2",
        "msg": sprintf("ec2 resource cost must be less than $200.00 (actual cost is $%.2f)", [cost]),
        "failed": true,
    }
}

deny contains out if {
    resource := input.projects[_].breakdown.resources[_]
    contains(lower(resource.name), "ebs")
    cost := to_number(resource.monthlyCost)
    cost >= 100.00

    out := {
